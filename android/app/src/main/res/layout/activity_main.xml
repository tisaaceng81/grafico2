<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtTituloMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="IsaacPlot"
        android:textColor="#1E293B"
        android:textSize="28sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/logo1"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center"
        android:layout_marginBottom="28dp"
        android:scaleType="fitCenter" />

    <Button
        android:id="@+id/btnGrafico2D"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#2563EB"
        android:text="Gráfico 2D"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnGrafico3D"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#2563EB"
        android:text="Gráfico 3D"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnGraficoEstatistico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#2563EB"
        android:text="Gráfico Estatístico"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnProbabilidade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#2563EB"
        android:text="Probabilidade"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>